# pyenv
#   For a library or package, you might want to ignore these files since the user is
#   responsible for mapping their own environment. For a binary, you probably want
#   to include them.
# .python-version

# pipenv
#   According to pypa/pipenv#1191, it is recommended to include Pipfile.lock in version control.
#   But if you're building a library, you should skip it.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# .pdm-python
# .pdm-build/

# PEP 582; used by e.g. github.com/frenzy-one/python-pdm-pep582
